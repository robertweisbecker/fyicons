        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "not": {
              "enum": [
                "all",
                "uncategorized"
              ]
            },
            "description": "Unique category ID. All and Uncategorized are automatic."
          },
          "name": {
            "type": "string",
            "pattern": "\\S",
            "description": "Display name used throughout the library."
          },
          "icon": {
            "$ref": "#/definitions/iconName",
            "description": "Catalog icon shown next to this category."
          },
          "keywords": {
            "type": "array",
            "uniqueItems": true,
