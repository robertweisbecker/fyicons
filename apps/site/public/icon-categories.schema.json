  "type": "object",
  "required": [
    "categories"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "description": "Keyword rules and category definitions in sidebar order.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "icon",
          "keywords"
