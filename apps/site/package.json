{
  "name": "@fyicons/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../.. run generate:icons && npm --prefix ../.. run build:package",
    "dev": "node ../../scripts/dev-site.mjs",
    "prebuild": "npm --prefix ../.. run generate:icons && npm --prefix ../.. run build:package",
    "build": "next build && node ../../scripts/compact-build-json.mjs && node ../../scripts/verify-site-export.mjs && node ../../scripts/measure-build.mjs",
    "preview": "node ../../scripts/preview-site.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@mdx-js/react": "3.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "fyicons": "0.4.2",
    "motion": "^14.0.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "3.1.1",
    "@next/mdx": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
