{
  "name": "fyicons-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=@fyicons/site --",
    "build": "npm run build --workspace=@fyicons/site --",
    "preview": "npm run preview --workspace=@fyicons/site --",
    "sync-icons": "node scripts/sync-icons.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:icons": "node scripts/generate-icons.mjs --check",
    "test:icons": "node --test tests/package/icons-source.test.mjs tests/package/react-icons.test.mjs",
    "test": "node --test tests/package/*.test.mjs tests/site/*.test.mjs",
    "pretest:site": "npm run build:package",
    "test:site": "node --test tests/site/*.test.mjs",
    "test:package": "node --test tests/package/*.test.mjs",
    "format": "prettier --write apps/site/src tests scripts *.json *.md docs .github/workflows/*.yml",
    "generate:category-schema": "node scripts/generate-category-schema.mjs",
    "build:package": "node scripts/build-package.mjs",
    "generate:registry": "node scripts/build-registry.mjs",
    "build:registry": "node scripts/build-registry.mjs --artifacts",
    "check:registry": "node scripts/build-registry.mjs --check",
    "changeset": "changeset",
    "version:packages": "node scripts/version-packages.mjs",
    "pack:package": "node scripts/pack-package.mjs",
    "diff:icons": "node scripts/diff-icons.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "changeset:icons": "node scripts/changeset-icons.mjs",
    "typecheck": "npm run build:package && npm run typecheck --workspace=@fyicons/site",
    "pretest": "npm run build:package"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fflate": "0.8.3",
    "jsdom": "27.0.1",
    "paper": "0.16.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rolldown": "1.2.11",
    "shadcn": "4.22.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.6.0"
}
